DATABASE_URL="postgresql://ads:generate-a-long-database-password@postgres:5432/ads_monitor?schema=public"
POSTGRES_PASSWORD="generate-a-long-database-password"
AUTH_SECRET="generate-a-64-char-random-secret"
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="generate-a-long-unique-password"
GOOGLE_PROXY_URL=""
